{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "types": ["node"], "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "outDir": "build", "rootDir": ".",
    "declaration": true, "sourceMap": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
